{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/deepseek-v4.1-flash:1017-cloud",
  "small_model": "ollama/deepseek-v4.1-flash:1017-cloud",
  "default_agent": "orchestrateur",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "deepseek-v4.1-flash:1017-cloud": {
          "name": "DeepSeek V4.1 Flash (Ollama Cloud)",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true
  },
  "instructions": ["docs/00-glossaire.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "cargo *": "allow",
      "uv *": "allow",
      "colgrep *": "allow",
      "date*": "allow",
      "rustc --version": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current": "allow",
      "git branch --list*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "du *": "allow",
      "which *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "jq *": "allow",
      "sed -n *": "allow",
      "cd *": "allow",
      "true": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git merge*": "deny",
      "git switch*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git tag*": "deny",
      "git push*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git rm *": "deny",
      "git mv *": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch -m*": "deny",
      "git filter-branch*": "deny",
      "git config*": "deny",
      "find *-delete*": "deny",
      "find *-exec*": "deny",
      "brew *": "deny",
      "npm install -g*": "deny",
      "npm i -g*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "sh": "deny",
      "bash": "deny",
      "zsh": "deny",
      "sudo *": "deny",
      "docker push*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    }
  },
  "watcher": {
    "ignore": ["target/**", "data/**", "**/.venv/**", "**/__pycache__/**"]
  }
}
