{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(.claude/agent.sh *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(colgrep *)",
      "Bash(jq *)",
      "Edit(/docs/suivi.md)"
    ],
    "deny": [
      "Agent",
      "Read(/.env.prod)",
      "Edit(/.env.prod)",
      "Edit(/crates/**)",
      "Edit(/tools/**)",
      "Edit(/clients/**)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git tag*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git config*)"
    ]
  }
}
