# Modèle de .env.prod — accès à la production Legifacile (ADR-0032).
# Copier en « .env.prod » (non versionné) et remplir avec les valeurs fournies par le propriétaire.
# Ne jamais versionner .env.prod ; ne citer que les noms de variables dans les documents.
PROD_SSH=utilisateur@hote
PROD_HOSTNAME=
PROD_REPO=/chemin/vers/legifacile-sandbox
PROD_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
PROD_DB_CONTAINER=
PROD_PGOPTIONS="-c default_transaction_read_only=on"
PROD_SERVICES=""
PROD_DAILY_WINDOW="05:30-06:30"
